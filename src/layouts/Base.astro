---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/dm-sans';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/toys.css';

type Props = {
  titulo?: string;
  descricao?: string;
};

const {
  titulo = 'Arthur Monteiro | TheKingArthur',
  descricao = 'Portfólio de Arthur Monteiro: projetos de front-end e sistemas, do mais simples ao mais difícil.',
} = Astro.props;

const imagem = new URL('/og.png', Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0e12" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagem} />
  </head>
  <body>
    <slot />
  </body>
</html>
