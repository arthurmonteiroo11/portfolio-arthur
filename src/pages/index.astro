---
import Base from '../layouts/Base.astro';
import Abertura from '../components/Abertura.astro';
import Arquivo from '../components/Arquivo.astro';
import Cena from '../components/Cena.astro';
import FimDeJogo from '../components/FimDeJogo.astro';
import Hud from '../components/Hud.astro';
import { fetchPublicRepos } from '../data/github.js';
import { buildCatalog } from '../data/catalogo.js';
import projetos from '../data/projetos.json';
import contato from '../data/contato.json';

const repos = await fetchPublicRepos('arthurmonteiroo11');
const { cenas, arquivo } = buildCatalog(repos, projetos);
---

<Base>
  <Hud />
  <main>
    <Abertura />
    {cenas.map((cena, indice) => <Cena cena={cena} indice={indice} />)}
    <Arquivo itens={arquivo} />
    <FimDeJogo contato={contato} />
  </main>
</Base>

<script>
  import { initScroll } from '../scripts/scroll.js';
  import { initScenes } from '../scripts/scenes.js';

  initScroll();
  initScenes(
    Array.from(document.querySelectorAll('[data-cena]')),
    document.querySelector('[data-fim]'),
  );
</script>
