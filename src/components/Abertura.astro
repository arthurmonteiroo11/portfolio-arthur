---
---

<section class="abertura" data-abertura aria-label="Apresentação">
  <canvas class="tela" data-abertura-canvas aria-hidden="true"></canvas>
  <div class="conteudo">
    <h1 class="nome" data-abertura-nome>Arthur Monteiro</h1>
    <p class="frase">Projetos do mais fácil ao mais difícil, como fases de um jogo.</p>
  </div>
  <p class="dica">Mexa o mouse ou arraste o dedo para montar o nome. Role para começar.</p>
</section>

<script>
  import { startOpening } from '../scripts/opening/index.js';
  import { prefersReducedMotion } from '../scripts/scroll.js';

  const tela = document.querySelector('[data-abertura-canvas]');
  const nome = document.querySelector('[data-abertura-nome]');

  if (tela instanceof HTMLCanvasElement && nome && !prefersReducedMotion()) {
    startOpening(tela, nome.textContent ?? 'Arthur Monteiro');
  }
</script>

<style>
  .abertura {
    position: relative;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
  }

  .tela {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .conteudo {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--espaco-3);
    padding: var(--espaco-3);
    text-align: center;
    pointer-events: none;
  }

  .nome {
    font-size: clamp(3rem, 15vw, 12rem);
    text-transform: uppercase;
    line-height: 0.92;
  }

  .tela[data-estado='ativo'] + .conteudo .nome {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .frase {
    position: absolute;
    left: 50%;
    bottom: 22svh;
    width: min(34ch, calc(100% - 2 * var(--espaco-3)));
    transform: translateX(-50%);
    color: var(--texto-suave);
  }

  .tela[data-estado='ativo'] + .conteudo .frase {
    bottom: 14svh;
  }

  .dica {
    position: absolute;
    left: 50%;
    bottom: var(--espaco-3);
    width: min(40ch, calc(100% - 2 * var(--espaco-3)));
    transform: translateX(-50%);
    color: var(--texto-suave);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
